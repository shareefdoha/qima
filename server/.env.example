# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qima_db
DB_CONNECTION_LIMIT=10

# Optional: set this to persistent storage when deploying to a managed host.
# UPLOAD_DIR=/path/to/persistent/uploads

# ---- Auth ----
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Used only by `npm run db:setup` to seed / reset the first admin account
SEED_ADMIN_EMAIL=admin@qima.qa
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=QIMA Administrator
